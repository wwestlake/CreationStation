  "blocks": [
    {
      "id": "menu",
      "kind": "paragraph",
      "text": "Click into the Signal Lab; the File menu then shows the signal items: New Signal, Open Signal..., Save Signal..., Render Signal to Project and Save Project."
    },
    {
      "id": "save",
      "kind": "steps",
      "title": "Save a signal",
      "steps": [
        {
          "id": "name",
          "instruction": "Give the signal a Sound Name in the Properties column."
        },
        {
          "id": "save",
          "instruction": "Choose File > Save Signal...",
          "expectedResult": "The signal is saved to the library as a project asset.",
          "uiTarget": "djehuti.station.file.save-signal"
        }
      ]
    },
    {
      "id": "render",
      "kind": "steps",
      "title": "Render a signal into the project",
      "steps": [
        {
          "id": "render",
          "instruction": "Choose File > Render Signal to Project.",
          "expectedResult": "A WAV is rendered and added to the project as a render asset named \"<name> Render\".",
          "uiTarget": "djehuti.station.file.render-signal"
        },
        {
          "id": "use",
          "instruction": "Find it in the Assets window, or place it on a track."
        }
      ]
    },
    {
      "id": "new-open",
      "kind": "paragraph",
      "text": "New Signal starts a blank graph. Open Signal... loads a saved one."
    }
  ],
