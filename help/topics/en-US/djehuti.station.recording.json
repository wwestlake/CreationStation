  "blocks": [
    {
      "id": "record",
      "kind": "steps",
      "title": "Record a take",
      "steps": [
        {
          "id": "device",
          "instruction": "Choose your input device with the Audio button.",
          "expectedResult": "The input appears in the track's input list.",
          "uiTarget": "djehuti.station.view.audio-devices"
        },
        {
          "id": "arm",
          "instruction": "On an audio track, choose the input source and press Arm.",
          "expectedResult": "The Arm button lights.",
          "uiTarget": "djehuti.station.tracker.arm"
        },
        {
          "id": "mono-st",
          "instruction": "Set Mono to record one input, or ST to record this input plus the next as stereo.",
          "uiTarget": "djehuti.station.tracker.channel-mode"
        },
        {
          "id": "monitor",
          "instruction": "Press Mon to hear the input while recording (optional).",
          "expectedResult": "You hear the input live.",
          "uiTarget": "djehuti.station.tracker.monitor"
        },
        {
          "id": "go",
          "instruction": "Press Record in the header.",
          "expectedResult": "The status line says \"Recording N track(s).\" and the clip grows as you record.",
          "uiTarget": "djehuti.station.transport.record"
        },
        {
          "id": "stop",
          "instruction": "Press Stop.",
          "expectedResult": "The take is saved into the project as an audio asset named like Take-<time>-T01-<track> and the clip plays from it."
        }
      ]
    },
    {
      "id": "multi",
      "kind": "paragraph",
      "text": "Every armed audio track records at once, each into its own take."
    },
    {
      "id": "track-type",
      "kind": "note",
      "text": "Only audio tracks record audio. Arming a track of another type is skipped, and the status line says which tracks were skipped."
    },
    {
      "id": "memory",
      "kind": "note",
      "text": "A recording is held in memory while it runs and written into the project when you stop; nothing is written to a temporary file."
    }
  ],
