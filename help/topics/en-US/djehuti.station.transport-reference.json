  "blocks": [
    {
      "id": "overview",
      "kind": "paragraph",
      "text": "The transport is in the header. It controls whichever panel has focus for Play, Pause and Stop: with the Tracker focused it plays the arrangement; with the Signal Lab focused it plays the sound you are designing."
    },
    {
      "id": "rewind-forward",
      "kind": "definition",
      "term": "Rew and Fwd",
      "definition": "Rewind moves the playhead back and Fast forward moves it forward. The status line reads \"Transport: rewind to start\" or \"Transport: fast forward to end\" for the jump versions."
    },
    {
      "id": "stop",
      "kind": "definition",
      "term": "Stop",
      "definition": "Stops playback and recording."
    },
    {
      "id": "play",
      "kind": "definition",
      "term": "Play",
      "definition": "Starts playback. With video clips on the timeline the Video panel opens and shows the picture."
    },
    {
      "id": "pause",
      "kind": "definition",
      "term": "Pause",
      "definition": "Pauses playback where it is."
    },
    {
      "id": "loop",
      "kind": "definition",
      "term": "Loop and loop delay",
      "definition": "Loop makes playback repeat the loop region. The field beside it (shown as 0.0s) sets a delay between loops, with + and - buttons."
    },
    {
      "id": "click",
      "kind": "definition",
      "term": "Click (metronome)",
      "definition": "Cycles through three settings: metronome off, on while playing or recording, and always on. The status line names the current one."
    },
    {
      "id": "record",
      "kind": "definition",
      "term": "Record",
      "definition": "Records every armed audio track. See the recording topic for how a take is saved."
    },
    {
      "id": "scrub",
      "kind": "note",
      "text": "A SCRUB indicator appears in the header when the X-Touch scrub mode is on. Jog-wheel scrubbing is not fully wired up yet."
    }
  ],
