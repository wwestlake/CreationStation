  "blocks": [
    {
      "id": "build",
      "kind": "steps",
      "title": "Build and play a sine tone",
      "steps": [
        {
          "id": "open",
          "instruction": "Open View > Signal and click into the panel so it has focus.",
          "expectedResult": "The Signal Lab shows a blank graph (\"Blank signal graph\").",
          "uiTarget": "djehuti.station.view.signal-lab"
        },
        {
          "id": "add-sine",
          "instruction": "Right-click an empty spot on the canvas and choose Sine Oscillator from Sources.",
          "expectedResult": "A Sine Osc node appears with a Level and a Freq."
        },
        {
          "id": "add-sink",
          "instruction": "Right-click again and add a Sink from I/O & Analysis.",
          "expectedResult": "A Sink node appears."
        },
        {
          "id": "wire",
          "instruction": "Drag from the Sine Osc's output port to the Sink's input port.",
          "expectedResult": "A wire joins them."
        },
        {
          "id": "play",
          "instruction": "Press Play in the header.",
          "expectedResult": "You hear a tone, and the status line says \"Playing live: 1 source(s), 1 wire(s)\".",
          "uiTarget": "djehuti.station.signal-lab.play"
        },
        {
          "id": "change",
          "instruction": "Select the Sine Osc and change its frequency or level.",
          "expectedResult": "The sound changes."
        },
        {
          "id": "stop",
          "instruction": "Press Stop.",
          "expectedResult": "The sound stops."
        }
      ]
    },
    {
      "id": "defaults",
      "kind": "note",
      "text": "A new oscillator has Level 0.65. The Sink plays for 5 seconds by default; the length shows on the Sink node."
    },
    {
      "id": "focus",
      "kind": "note",
      "text": "Play acts on the panel that has focus. If nothing plays, click into the Signal Lab first."
    }
  ],
