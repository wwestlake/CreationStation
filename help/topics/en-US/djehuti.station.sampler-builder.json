    {
      "id": "build",
      "kind": "steps",
      "title": "Build a pack",
      "steps": [
        {
          "id": "open",
          "instruction": "Open View > Sampler, or press Build Sample Pack... in the Plugins panel.",
          "expectedResult": "The Sample Pack Builder opens.",
          "uiTarget": "djehuti.station.view.sampler"
        },
        {
          "id": "input",
          "instruction": "Under Raw captures folder press Browse... and choose the folder of raw single-note captures."
        },
        {
          "id": "export",
          "instruction": "Under Export folder choose where the pack should be exported."
        },
        {
          "id": "go",
          "instruction": "Press Build Sample Pack.",
          "expectedResult": "The status shows the build; a failure shows \"Build failed\" with the reason.",
          "uiTarget": "djehuti.station.sampler.build-pack"
        }
      ]
    },
    {
      "id": "valid",
      "kind": "note",
      "text": "Choose a valid input folder and an export folder first; the panel tells you when either is missing."
    }
  ],
