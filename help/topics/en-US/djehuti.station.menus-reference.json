  "blocks": [
    {
      "id": "file-follows-focus",
      "kind": "paragraph",
      "text": "The File menu follows the panel that has focus. Click into the Tracker and File shows the arrangement items; click into the Signal Lab and it shows the signal items. Projects themselves are managed from the Project button in the header, not from File."
    },
    {
      "id": "file-common",
      "kind": "definition",
      "term": "File (always)",
      "definition": "Import... opens the import window. Save (shown as Save Project in the Signal Lab) saves the project."
    },
    {
      "id": "file-tracker",
      "kind": "definition",
      "term": "File (Tracker focused)",
      "definition": "New Arrangement, Save Arrangement..., Load Arrangement..., Render Full Mix..., Export Full Mix as WAV..."
    },
    {
      "id": "file-signal",
      "kind": "definition",
      "term": "File (Signal Lab focused)",
      "definition": "New Signal, Open Signal..., Save Signal..., Render Signal to Project, then Save Project."
    },
    {
      "id": "edit",
      "kind": "definition",
      "term": "Edit",
      "definition": "Undo (Ctrl+Z), Redo (Ctrl+Y), Duplicate Clip (Ctrl+D), Split at Playhead (Ctrl+Shift+S), Rename Clip (F2), Delete Clip (Delete). The clip items need a selected clip. Undo and Redo go to the focused panel: the Tracker or the Signal Lab."
    },
    {
      "id": "view",
      "kind": "definition",
      "term": "View",
      "definition": "Opens and closes panels: Tracker, Sampler, Signal, Layers, Plugins, Script, Capture, Score, Settings, Foley, Video, Track Insert, Virtual Engineer; and Reset Dock Layout."
    },
    {
      "id": "help",
      "kind": "definition",
      "term": "Help",
      "definition": "Help Topics (F1), Guided Tour and Send Feedback..."
    }
  ],
