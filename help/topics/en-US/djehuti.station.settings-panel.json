  "blocks": [
    {
      "id": "panel",
      "kind": "paragraph",
      "text": "The Settings panel (View > Settings) is searchable and its sections collapse: Audio system, Input device, Output device, Studio Inputs, MIDI, Startup, Project, Storage folder and Tools. A section with a search match opens itself."
    },
    {
      "id": "suite",
      "kind": "paragraph",
      "text": "The gear button in the header opens Djehuti Suite settings, shared by every suite application. Its tabs include Storage, Suite AI Accounts and Suite Log."
    },
    {
      "id": "saving",
      "kind": "paragraph",
      "text": "Settings you change are saved into the project storage, not into files on your computer."
    }
  ],
