  "blocks": [
    {
      "id": "what",
      "kind": "paragraph",
      "text": "Layers shows the tracks as channel strips under the title Mixing Console, a bank at a time. Bank - and Bank + page to the previous or next set of channels; the bank label shows which channels are visible."
    },
    {
      "id": "mute",
      "kind": "definition",
      "term": "Mute",
      "definition": "Silences the channel."
    },
    {
      "id": "solo",
      "kind": "definition",
      "term": "Solo",
      "definition": "Plays only soloed channels."
    },
    {
      "id": "fx",
      "kind": "definition",
      "term": "FX",
      "definition": "Opens the channel's effects chain (the insert chain)."
    },
    {
      "id": "hardware",
      "kind": "note",
      "text": "A control surface such as the X-Touch follows the same bank."
    }
