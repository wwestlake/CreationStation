  "blocks": [
    {
      "id": "timing",
      "kind": "definition",
      "term": "Project timing",
      "definition": "The timing bar shows the tempo in BPM (a new project starts at 120.0), the time signature (4/4) and the musical key. Change them by editing the fields."
    },
    {
      "id": "snap",
      "kind": "definition",
      "term": "Snap and grid",
      "definition": "The Snap switch makes the loop region and other drags snap to the grid. The grid resolution can be 1 Bar, 1/2, 1/4, 1/8, 1/16 or 1/32."
    },
    {
      "id": "loop",
      "kind": "definition",
      "term": "Loop",
      "definition": "The Loop button in the header repeats the loop region during playback. The loop delay field sets a pause between repeats."
    },
    {
      "id": "markers",
      "kind": "definition",
      "term": "Markers",
      "definition": "Right-click the timeline and choose Add Marker Here to place a named marker; click a marker to move the playhead to it; Delete Marker removes it."
    },
    {
      "id": "pitch-pipe",
      "kind": "definition",
      "term": "Pitch pipe",
      "definition": "Pick a note and octave and press Play to hear a reference tone for 2 seconds."
    }
  ],
