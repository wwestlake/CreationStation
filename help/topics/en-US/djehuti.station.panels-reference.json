  "blocks": [
    {
      "id": "how-to-open",
      "kind": "paragraph",
      "text": "Open or close a panel from the View menu. A checked entry means the panel is open."
    },
    {
      "id": "tracker",
      "kind": "definition",
      "term": "Tracker",
      "definition": "The timeline. Tracks run across, clips sit on tracks, and the playhead moves along the top. This is where you arrange audio, MIDI, automation, Signal, Foley and video material."
    },
    {
      "id": "layers",
      "kind": "definition",
      "term": "Layers",
      "definition": "The mixing console: channel strips in banks, with Mute, Solo and FX per channel and Bank - / Bank + to page through channels."
    },
    {
      "id": "signal",
      "kind": "definition",
      "term": "Signal (Signal Lab)",
      "definition": "A node-graph sound designer. You wire sources such as oscillators through processing nodes to a Sink and play the result live. Signals can be saved, rendered to the project and placed on the timeline."
    },
    {
      "id": "plugins",
      "kind": "definition",
      "term": "Plugins (Plugin Studio)",
      "definition": "Manage the folders searched for VST plugins, browse the plugins found, and load one into a track's insert chain. Build Sample Pack opens the sample pack builder."
    },
    {
      "id": "sampler",
      "kind": "definition",
      "term": "Sampler (Sample Pack Builder)",
      "definition": "Turns a folder of scattered single-note recordings into a chromatic sample pack."
    },
    {
      "id": "capture",
      "kind": "definition",
      "term": "Capture (Capture Booth)",
      "definition": "Arm source lanes, monitor inputs and grab fresh material for Foley and sound design; recent captures are listed here."
    },
    {
      "id": "score",
      "kind": "definition",
      "term": "Score (Score Studio)",
      "definition": "Compose with notation: a grand staff or piano roll, notes, lyrics, teaching cues and an AI composition coach."
    },
    {
      "id": "foley",
      "kind": "definition",
      "term": "Foley",
      "definition": "A node-graph editor for sequencing and choice logic. It generates FRust source and can build a reusable pod."
    },
    {
      "id": "script",
      "kind": "definition",
      "term": "Script",
      "definition": "The Djehuti Suite Language (FRust) editor with a Compile button."
    },
    {
      "id": "video",
      "kind": "definition",
      "term": "Video",
      "definition": "The picture window for video clips. It opens when you press Play with video on the timeline. A status strip under the picture reports what the video side is doing."
    },
    {
      "id": "track-insert",
      "kind": "definition",
      "term": "Track Insert",
      "definition": "The insert (effects) chain of the selected track, or of the master when no track is selected."
    },
    {
      "id": "settings",
      "kind": "definition",
      "term": "Settings",
      "definition": "Audio system, input and output devices, MIDI, startup, storage and tool settings, with a search box."
    },
    {
      "id": "virtual-engineer",
      "kind": "definition",
      "term": "Virtual Engineer",
      "definition": "An AI assistant panel. It answers questions and helps with building and debugging, using one of your suite AI accounts."
    }
  ],
