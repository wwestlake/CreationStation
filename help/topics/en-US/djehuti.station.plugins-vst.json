  "blocks": [
    {
      "id": "folders",
      "kind": "steps",
      "title": "Tell Station where your plugins are",
      "steps": [
        {
          "id": "open",
          "instruction": "Open View > Plugins.",
          "expectedResult": "The Plugin Studio opens with VST Folders and a Plugin Browser.",
          "uiTarget": "djehuti.station.view.plugins"
        },
        {
          "id": "add",
          "instruction": "Press Add Folder and choose a folder that contains VST plugins.",
          "expectedResult": "The folder is listed.",
          "uiTarget": "djehuti.station.plugins.vst-folders"
        },
        {
          "id": "rescan",
          "instruction": "Press Rescan to search all VST folders.",
          "expectedResult": "Discovered plugins appear in the browser."
        }
      ]
    },
    {
      "id": "import-list",
      "kind": "paragraph",
      "text": "Import Path List adds several folders at once from a list. Remove a folder from the list to stop searching it."
    },
    {
      "id": "browse",
      "kind": "paragraph",
      "text": "The Plugin Browser has a search box and a format filter (All Formats). Select a plugin and press Load To Insert to add it to the selected track."
    },
    {
      "id": "sample-pack",
      "kind": "paragraph",
      "text": "Build Sample Pack... opens the Sample Pack Builder for turning single-note recordings into a sample pack."
    }
  ],
