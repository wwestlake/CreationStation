  "blocks": [
    {
      "id": "concept",
      "kind": "paragraph",
      "text": "A project can hold many arrangements, but the Tracker shows one at a time. Saved arrangements are project assets. The Tracker tab shows the open arrangement: \"Tracker - <name>\", or \"Tracker - Untitled\" for one that has not been saved, with a * added while there are unsaved changes."
    },
    {
      "id": "new",
      "kind": "steps",
      "title": "Start a new arrangement",
      "steps": [
        {
          "id": "menu",
          "instruction": "Click into the Tracker, then choose File > New Arrangement.",
          "expectedResult": "If the arrangement has unsaved changes you are asked: Save, Don't Save, or Cancel.",
          "uiTarget": "djehuti.station.file.new-arrangement"
        },
        {
          "id": "result",
          "instruction": "Choose one.",
          "expectedResult": "The Tracker is empty and the status line says \"New arrangement.\""
        }
      ]
    },
    {
      "id": "undo",
      "kind": "note",
      "text": "New Arrangement can be undone with Ctrl+Z, which brings the old arrangement back. Saved arrangements are never touched."
    },
    {
      "id": "save",
      "kind": "steps",
      "title": "Save the arrangement",
      "steps": [
        {
          "id": "save-item",
          "instruction": "Choose File > Save Arrangement...",
          "expectedResult": "You are asked for a name.",
          "uiTarget": "djehuti.station.file.save-arrangement"
        },
        {
          "id": "name",
          "instruction": "Type a name and confirm.",
          "expectedResult": "The tab shows the name without a *."
        }
      ]
    },
    {
      "id": "load",
      "kind": "steps",
      "title": "Load an arrangement",
      "steps": [
        {
          "id": "load-item",
          "instruction": "Choose File > Load Arrangement...",
          "expectedResult": "A list of the project's saved arrangements appears, newest first.",
          "uiTarget": "djehuti.station.file.load-arrangement"
        },
        {
          "id": "pick",
          "instruction": "Pick one.",
          "expectedResult": "It replaces the Tracker's contents."
        }
      ]
    }
  ],
