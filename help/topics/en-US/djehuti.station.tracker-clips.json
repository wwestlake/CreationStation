  "blocks": [
    {
      "id": "add",
      "kind": "steps",
      "title": "Add a clip",
      "steps": [
        {
          "id": "right-click",
          "instruction": "Right-click an empty spot on the track where the clip should go.",
          "expectedResult": "A menu appears."
        },
        {
          "id": "add-clip",
          "instruction": "Choose Add Clip...",
          "expectedResult": "A picker lists the project's assets that fit this kind of track, first, with a thumbnail and facts for each; others follow."
        },
        {
          "id": "pick",
          "instruction": "Choose an asset.",
          "expectedResult": "The clip is placed at the spot you clicked."
        }
      ]
    },
    {
      "id": "drop",
      "kind": "paragraph",
      "text": "You can also drop audio or video files from Windows onto the timeline, or use Place on Track in the Assets window."
    },
    {
      "id": "move",
      "kind": "paragraph",
      "text": "Drag a clip to move it along the track or to another track of a matching kind."
    },
    {
      "id": "split",
      "kind": "definition",
      "term": "Split at Playhead",
      "definition": "Cuts the selected clip in two at the playhead (Ctrl+Shift+S, or Edit > Split at Playhead, or the clip's right-click menu). The playhead must be inside the clip."
    },
    {
      "id": "duplicate",
      "kind": "definition",
      "term": "Duplicate clip",
      "definition": "Makes a copy of the selected clip (Ctrl+D)."
    },
    {
      "id": "rename",
      "kind": "definition",
      "term": "Rename clip",
      "definition": "Changes the clip's name (F2)."
    },
    {
      "id": "delete",
      "kind": "definition",
      "term": "Delete clip",
      "definition": "Removes the clip from the timeline (Delete key). The asset stays in the project. It can be undone."
    },
    {
      "id": "select",
      "kind": "note",
      "text": "Click a clip to select it. The clip commands are unavailable until a clip is selected."
    }
  ],
