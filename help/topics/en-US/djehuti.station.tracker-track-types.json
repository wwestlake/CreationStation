    {
      "id": "choose",
      "kind": "paragraph",
      "text": "Choose a track's kind with the kind button in its header (\"Choose what kind of material this track contains\"). A clip can only live on a track that can hold it."
    },
    {
      "id": "audio",
      "kind": "definition",
      "term": "Audio",
      "definition": "Recorded or imported sound. Audio tracks can be armed and recorded."
    },
    {
      "id": "midi",
      "kind": "definition",
      "term": "MIDI",
      "definition": "Note patterns played by an instrument plugin."
    },
    {
      "id": "automation",
      "kind": "definition",
      "term": "Automation",
      "definition": "Lanes that move a control over time. See the automation topic."
    },
    {
      "id": "signal",
      "kind": "definition",
      "term": "Signal",
      "definition": "Clips made from Signal Lab patches, played live by the timeline."
    },
    {
      "id": "foley",
      "kind": "definition",
      "term": "Foley",
      "definition": "Foley setups and sound-design material."
    },
    {
      "id": "folder",
      "kind": "definition",
      "term": "Folder",
      "definition": "Groups other tracks. Move a track into a folder with Move to Folder..."
    },
    {
      "id": "marker",
      "kind": "definition",
      "term": "Marker",
      "definition": "A row for timeline markers."
    },
    {
      "id": "video",
      "kind": "definition",
      "term": "Video",
      "definition": "Video clips. A video track is created automatically when you drop or place a video."
    }
  ],
