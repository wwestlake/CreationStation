<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Djehuti Station installer (WiX v3). Built by the release pipeline (installer/build-msi.ps1); nothing here is meant
  to be built by hand.

  It installs Station, and the Djehuti Suite's storage service that Station cannot run without (the shared fragment
  services/VfsService/installer/SuiteServices.wxs, linked in by the build script). An older copy of the service is
  replaced, a newer one is left alone. If the service cannot be installed the whole installation fails, so nobody is left
  with a Station that cannot start.

  Variables passed by the build script: Version, StageDir (holds DjehutiStation.exe and the docs), EulaRtf, and
  VfsServiceExe (for the fragment).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Djehuti Station" Language="1033" Version="$(var.Version)" Manufacturer="LagDaemon Software"
           UpgradeCode="9F39E8E4-3B66-4EE8-8B7E-8E9D9B7F35D2">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="Djehuti Station" Manufacturer="LagDaemon Software" />

    <!-- The upgrade code is the one the earlier installers used, so this replaces an installed Station. Betas share a
         version number, so installing over the same version is allowed. The old product is removed after the new files are
         in place, so the shared service is never briefly uninstalled. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of Djehuti Station is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Condition Message="Djehuti Station needs 64-bit Windows 10 or later.">
      <![CDATA[Installed OR VersionNT64 >= 603]]>
    </Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="DjehutiStation" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="StationMenuFolder" Name="Djehuti Station" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <Feature Id="StationFeature" Title="Djehuti Station" Level="1" Absent="disallow" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="StationExe" />
      <ComponentRef Id="StationReadme" />
      <ComponentRef Id="StationLicense" />
      <ComponentRef Id="StationEula" />
      <ComponentRef Id="StationMenuShortcut" />
      <ComponentRef Id="StationDesktopShortcut" />
      <!-- Required, not optional: Station cannot run without the storage service. -->
      <ComponentGroupRef Id="SuiteServicesGroup" />
    </Feature>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="StationExe" Guid="*" Win64="yes">
        <File Id="DjehutiStation.exe" Name="DjehutiStation.exe" Source="$(var.StageDir)\DjehutiStation.exe" KeyPath="yes" Vital="yes" />
      </Component>
      <!-- One file per component: a component with several files cannot use an automatically generated GUID. -->
      <Component Id="StationReadme" Guid="*" Win64="yes">
        <File Id="README.md" Name="README.md" Source="$(var.StageDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="StationLicense" Guid="*" Win64="yes">
        <File Id="LICENSE" Name="LICENSE" Source="$(var.StageDir)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="StationEula" Guid="*" Win64="yes">
        <File Id="EULA.txt" Name="EULA.txt" Source="$(var.StageDir)\EULA.txt" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- The shortcut components' key paths are per-user (HKCU): Windows Installer's validation requires it for shortcuts in the
         Start menu and desktop folders (ICE38, ICE43). In a per-machine install that trips a third rule, ICE57, which
         contradicts those two, so build-msi.ps1 skips it. This is the usual pattern; do not change these to HKLM. -->
    <DirectoryRef Id="StationMenuFolder">
      <Component Id="StationMenuShortcut" Guid="*" Win64="yes">
        <Shortcut Id="StationMenuLink" Name="Djehuti Station" Target="[INSTALLFOLDER]DjehutiStation.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStationMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\LagDaemon Software\Djehuti Station" Name="MenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="StationDesktopShortcut" Guid="*" Win64="yes">
        <Shortcut Id="StationDesktopLink" Name="Djehuti Station" Target="[INSTALLFOLDER]DjehutiStation.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\LagDaemon Software\Djehuti Station" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- The usual install dialogs: licence, folder, progress. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.EulaRtf)" />
    <UIRef Id="WixUI_InstallDir" />
  </Product>
</Wix>
