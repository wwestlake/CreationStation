// The Station API a script can call. This one file is both the declaration the compiler links the
// script against and the reference the Virtual Engineer is shown, so the two cannot disagree.
//
// A script is FRust source that defines:
//
//     pub fn run() -> String = { ... }
//
// The text it returns is reported back. Everything a script does to the project goes through the
// functions below; a script has no other access to the machine.
//
// Conventions: tracks are numbered from 1, as the user sees them. Functions that change something
// return 1 when it worked and 0 when it did not (a bad track number, a value out of range). Read
// `station_last_error()` after a 0 to see why.

// ---- Reading the project ----
extern fn station_project_summary() -> String;       // arrangement name, track count, transport state
extern fn station_track_count() -> i64;
extern fn station_track_name(track: i64) -> String;  // "" if there is no such track
extern fn station_track_volume_db(track: i64) -> f64;
extern fn station_track_pan(track: i64) -> f64;      // -1.0 (left) to 1.0 (right)
extern fn station_track_muted(track: i64) -> i64;    // 1 or 0
extern fn station_track_soloed(track: i64) -> i64;   // 1 or 0

// ---- Changing tracks ----
extern fn station_track_add(name: String) -> i64;    // returns the new track's number, or 0 if it failed
extern fn station_track_set_name(track: i64, name: String) -> i64;
extern fn station_track_set_volume_db(track: i64, db: f64) -> i64;  // -60.0 to +6.0
extern fn station_track_set_pan(track: i64, pan: f64) -> i64;       // -1.0 to 1.0
extern fn station_track_set_muted(track: i64, muted: i64) -> i64;
extern fn station_track_set_soloed(track: i64, soloed: i64) -> i64;

// ---- Transport ----
extern fn station_transport_play() -> i64;
extern fn station_transport_stop() -> i64;

// ---- Reporting ----
extern fn station_log(text: String) -> i64;          // adds a line to what the script reports
extern fn station_last_error() -> String;            // why the last call that returned 0 failed
