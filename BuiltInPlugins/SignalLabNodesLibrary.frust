// sin is a host-registered native function (creation::frust::PluginRuntime::
// registerHostFunction), not a FRust language intrinsic -- FRust has no
// built-in math functions today. Real-time-safe: plain scalar f64 in/out,
// no struct/enum/own/weak construction anywhere in this file, so nothing
// here ever calls malloc -- see LANGUAGE_GAPS.md's Array<N> entry for why
// that property matters for anything that might run on an audio callback.
extern fn sin(x: f64) -> f64;

// The node graph supplies both values. Station resolves this function once
// when its live Signal Lab voice is constructed, then calls the compiled
// function pointer from the audio callback; compilation never occurs on the
// real-time thread.
pub fn sine_oscillator(phase: f64, level: f64) -> f64 = {
    sin(phase) * level
}
